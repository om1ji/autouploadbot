# Copy to samconfig.toml and fill in your values:
#   cp samconfig.toml.example samconfig.toml
# samconfig.toml is git-ignored: it ends up holding account-specific data
# (ECR repository URIs with your AWS account ID).
version = 0.1

[default.deploy.parameters]
stack_name = "autouploadbot"
resolve_s3 = true
resolve_image_repos = true
s3_prefix = "autouploadbot"
region = "us-west-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
# AdminChatId: ID of the admin group — alerts go there and its members manage
#   the bot. Add the bot to the group, send a message, then read chat.id from
#   https://api.telegram.org/bot<token>/getUpdates (a negative number).
# AdminUtcOffset: hours from UTC for times the admin bot shows.
# Channels are not a parameter: they live in ChannelsTable and are managed from
# the admin chat or with tools/channels.py.
parameter_overrides = "AdminUtcOffset=\"0\" AdminChatId=\"-1234567890\""

[default.global.parameters]
region = "us-west-1"
