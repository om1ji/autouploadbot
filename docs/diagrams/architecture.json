      "dot": "cyan",
      "title": "Two ingest paths",
      "items": [
        "Push: hub POSTs a signed Atom entry within seconds",
        "Poll: RSS every 15 min, works without the hub",
        "Both feed one queue; each chat gets a video once"
      ]
    },
