      "label": "YouTube",
      "sublabel": "publisher",
      "brand": "youtube"
    }
  ],
  "segments": [
    {
      "from": 150,
      "to": 334,
      "label": "1. Subscribe"
    },
    {
      "from": 356,
      "to": 420,
      "label": "2. Verify intent"
    },
    {
      "from": 442,
      "to": 536,
      "label": "3. Deliver"
    }
  ],
  "messages": [
